# Supabase Postgres connection string (use the project's connection details).
# Keep the password private. The backend requires TLS for Supabase connections.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DATABASE_PASSWORD@db.your-project.supabase.co:5432/postgres

# Generate a unique random secret for production.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Configure at least one AI provider.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEFAULT_AI_PROVIDER=gemini

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100
HOST=0.0.0.0
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:3000
RECORDING_RETENTION_DAYS=90
