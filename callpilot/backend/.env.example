# Use the same MongoDB URI and database as the Lead N website deployment.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=leadn

# Must match JWT_SECRET configured by the website. Mobile users log in to the same account.
JWT_SECRET_KEY=replace-with-the-same-long-random-secret-as-the-website
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# AI Providers
OPENAI_API_KEY=
GEMINI_API_KEY=
DEFAULT_AI_PROVIDER=openai

# Server and CORS
HOST=0.0.0.0
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,https://leadn.com

# Local recording processing
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100
RECORDING_RETENTION_DAYS=90
