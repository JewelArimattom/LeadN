# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/leadn?retryWrites=true&w=majority

# Set a private secret in both the website and CallPilot backend deployments.
JWT_SECRET=replace-with-the-same-long-random-secret-as-the-CallPilot-backend

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@leadn.com
NOTIFICATION_EMAIL=team@leadn.com

# Analytics (optional)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Rate limiting
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
